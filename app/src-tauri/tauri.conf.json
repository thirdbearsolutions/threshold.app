{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Threshold",
  "version": "0.1.0",
  "identifier": "com.thirdbear.threshold",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1500",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Threshold",
        "label": "main",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A review inbox where a coding agent hands you a change and you talk it through before it lands.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "MacOS/git": "binaries/git"
      }
    }
  }
}
